<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:keepScreenOn="true">

    <!-- Primary Camera Preview (CameraX PreviewView) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/primaryPreview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:scaleType="fillCenter" />

    <!-- 50% Center Guidelines for True Split Screen Layouts -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCenterH"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCenterV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Secondary Split Camera View (Side-by-Side or Top-Bottom Split) -->
    <FrameLayout
        android:id="@+id/secondarySplitContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/guidelineCenterH">

        <androidx.camera.view.PreviewView
            android:id="@+id/secondarySplitPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:scaleType="fillCenter" />

        <ImageView
            android:id="@+id/ivSplitSnapshot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Accent Border Line for Split View -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:background="@color/accent_gold" />
    </FrameLayout>

    <!-- Transition Snapshot Overlay for Seamless Live 3D Camera Switch -->
    <ImageView
        android:id="@+id/ivSwitchTransition"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="2dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Floating Draggable & Resizable PiP Window Container -->
    <FrameLayout
        android:id="@+id/pipContainer"
        android:layout_width="120dp"
        android:layout_height="180dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="88dp"
        android:background="@drawable/bg_pip_frame"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="2dp"
            app:cardBackgroundColor="@color/bg_black"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <androidx.camera.view.PreviewView
                android:id="@+id/pipPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:scaleType="fillCenter" />

            <ImageView
                android:id="@+id/ivPipSnapshot"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- PiP Swap Icon Hint Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:background="@drawable/bg_glass_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_flip_cam"
                    app:tint="@color/accent_gold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="SWAP"
                    android:textColor="@color/accent_gold"
                    android:textSize="9sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!-- Grid Lines Overlay View -->
    <com.antigravity.dualcam.ui.GridOverlayView
        android:id="@+id/gridOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Focus & Exposure Reticle View -->
    <com.antigravity.dualcam.ui.FocusReticleView
        android:id="@+id/focusReticle"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top OSD Status Bar (Spaced Left/Right Clusters to clear Punch-Hole Camera) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="14dp"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Left Cluster: Resolution & FPS -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnResolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="1080P"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnFps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_glass_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="30 FPS"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Center Spacer: Leaves Room for Center Punch-Hole Camera / Dynamic Island -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Right Cluster: Storage & Hardware Dual Cam Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStorageInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_pill"
                android:fontFamily="monospace"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp"
                android:text="48 GB"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/badgeHardwareAudit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_glass_pill"
                android:clickable="true"
                android:drawableStart="@drawable/ic_circle_badge"
                android:drawablePadding="4dp"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp"
                android:text="DUAL CAM"
                android:textColor="@color/accent_gold"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Centered Audio dB Meter Visualizer (Cine-Style Header Placement) -->
    <com.antigravity.dualcam.ui.AudioVisualizerView
        android:id="@+id/audioVisualizer"
        android:layout_width="72dp"
        android:layout_height="18dp"
        android:layout_marginTop="6dp"
        android:elevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- Side Quick Tools Bar (Right Edge - Flash, Mic, Grid, Timer) -->
    <LinearLayout
        android:id="@+id/sideToolsBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="14dp"
        android:elevation="6dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <!-- Flash / Torch -->
        <ImageView
            android:id="@+id/btnTorch"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_glass_pill"
            android:contentDescription="@string/flash_torch"
            android:padding="8dp"
            android:src="@drawable/ic_torch_off"
            app:tint="@color/text_primary" />

        <!-- Microphone -->
        <ImageView
            android:id="@+id/btnMic"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_glass_pill"
            android:contentDescription="@string/audio"
            android:padding="8dp"
            android:src="@drawable/ic_mic_on"
            app:tint="@color/text_primary" />

        <!-- Grid -->
        <ImageView
            android:id="@+id/btnGrid"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_glass_pill"
            android:contentDescription="@string/grid"
            android:padding="8dp"
            android:src="@drawable/ic_grid"
            app:tint="@color/text_primary" />

        <!-- Timer -->
        <ImageView
            android:id="@+id/btnTimer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_glass_pill"
            android:contentDescription="@string/timer"
            android:padding="8dp"
            android:src="@drawable/ic_timer"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- Center Active Recording HUD Banner -->
    <LinearLayout
        android:id="@+id/recordingBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_glass_pill"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="7dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomDeck"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/recDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_circle_badge" />

        <TextView
            android:id="@+id/tvRecTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:text="00:00:00"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Pause / Resume Button -->
        <ImageView
            android:id="@+id/btnPauseResume"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="12dp"
            android:clickable="true"
            android:contentDescription="@string/pause"
            android:focusable="true"
            android:src="@drawable/ic_pause"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- Big Countdown Overlay (3, 2, 1) -->
    <TextView
        android:id="@+id/tvCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="15dp"
        android:fontFamily="sans-serif-black"
        android:textColor="@color/accent_gold"
        android:textSize="96sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="3" />

    <!-- Lock AE/AF Indicator -->
    <TextView
        android:id="@+id/tvLockAeAf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_glass_pill"
        android:elevation="8dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="AE/AF LOCKED"
        android:textColor="@color/accent_gold"
        android:textSize="11sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- Two-Tier Bottom Controls Deck (ZERO OVERLAP GUARANTEED) -->
    <LinearLayout
        android:id="@+id/bottomDeck"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#B8000000"
        android:elevation="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Tier 1: Mode Dock (Templates / Dual Cam / Pro Controls Pills) -->
        <LinearLayout
            android:id="@+id/modeDock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Templates Mode Pill -->
            <LinearLayout
                android:id="@+id/btnTemplates"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_glass_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_templates"
                    app:tint="@color/accent_blue" />

                <TextView
                    android:id="@+id/tvActiveTemplateLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="TEMPLATES"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Dual-Camera Layout Switch Pill -->
            <LinearLayout
                android:id="@+id/btnDualCamMode"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_glass_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_dual_cam"
                    app:tint="@color/accent_gold" />

                <TextView
                    android:id="@+id/tvActiveDualModeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="DUAL CAM"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Pro Controls Pill -->
            <LinearLayout
                android:id="@+id/btnPro"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_glass_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_pro"
                    app:tint="@color/accent_cyan" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="PRO"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Native Ergonomic Horizontal Zoom Selector Strip (0.5x, 1x, 2x, 5x) -->
        <LinearLayout
            android:id="@+id/zoomBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="3dp">

            <TextView
                android:id="@+id/btnZoomWide"
                android:layout_width="44dp"
                android:layout_height="28dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="0.5x"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnZoom1x"
                android:layout_width="44dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_glass_pill_active"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="1x"
                android:textColor="@color/bg_black"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnZoom2x"
                android:layout_width="44dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="2x"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnZoom5x"
                android:layout_width="44dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="5x"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tier 2: Shutter Action Row (Gallery Far-Left, Record Dead-Center, Flip Far-Right) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/shutterRow"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginTop="6dp">

            <!-- Gallery Thumbnail Button (Far Left) -->
            <FrameLayout
                android:id="@+id/btnGallery"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="28dp"
                android:background="@drawable/bg_glass_card"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivGalleryThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/gallery"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_gallery"
                    app:tint="@color/text_secondary" />
            </FrameLayout>

            <!-- Master Record / Shutter Button (Dead Center) -->
            <FrameLayout
                android:id="@+id/btnRecord"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:clickable="true"
                android:contentDescription="@string/record"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Outer White Ring -->
                <View
                    android:id="@+id/recordRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/btn_record_outer" />

                <!-- Inner Red Circle -->
                <View
                    android:id="@+id/recordInner"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:background="@drawable/btn_record_inner" />
            </FrameLayout>

            <!-- Camera Flip Button (Far Right) -->
            <FrameLayout
                android:id="@+id/btnFlipCamera"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/bg_glass_pill"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivFlipIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/flip_camera"
                    android:src="@drawable/ic_flip_cam"
                    app:tint="@color/text_primary" />
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- Pro Controls Drawer (Expandable Bottom Sheet, replaces bottomDeck when active) -->
    <include
        android:id="@+id/proDrawer"
        layout="@layout/layout_pro_drawer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
